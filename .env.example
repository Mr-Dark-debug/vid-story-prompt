# Public Supabase browser configuration
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
PUBLIC_APP_URL=http://localhost:3000

# Optional search-engine ownership verification (public metadata tokens)
VITE_GOOGLE_SITE_VERIFICATION=3X4sNiR4A5uIQ1uzPN-jeIqr2Snd7fZiAwYYv6J2dt8
VITE_BING_SITE_VERIFICATION=
INDEXNOW_TRIGGER_SECRET=

# Server-only Supabase configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Official YouTube and Google OAuth configuration
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=
YOUTUBE_WEBHOOK_SECRET=

# Import connector OAuth (server only)
CONNECTOR_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CONTENT_POSTING_AUDITED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202605

# Abuse protection
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# AI providers
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CLIP_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_CLIP_MODEL=
OPENROUTER_CLIP_FALLBACK_MODELS=

# Worker and queue
WORKER_ID=video-worker-local
VIDEO_WORKER_URL=
WORKER_WAKE_SECRET=
QUEUE_POLL_INTERVAL_MS=1000
TASK_VISIBILITY_TIMEOUT_SECONDS=120
# Optional comma-separated capability routing. Includes are an allowlist; excludes always win.
# A residential acquisition worker should include only download_youtube_source.
WORKER_TASK_INCLUDE_TYPES=
WORKER_TASK_EXCLUDE_TYPES=
WORKER_CONNECTOR_TASKS_ENABLED=true
SOURCE_VALIDATION_CONCURRENCY=4
PROXY_CONCURRENCY=2
AUDIO_EXTRACTION_CONCURRENCY=3
TRANSCRIPTION_CONCURRENCY=4
AI_PLANNING_CONCURRENCY=6
PREVIEW_RENDER_CONCURRENCY=2
EXPORT_RENDER_CONCURRENCY=1
MAX_DIRECT_DOWNLOAD_BYTES=10737418240
DIRECT_DOWNLOAD_CONNECT_TIMEOUT_MS=10000
DIRECT_DOWNLOAD_READ_TIMEOUT_MS=300000
DIRECT_DOWNLOAD_REDIRECT_LIMIT=4
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT_MS=600000
YTDLP_POT_PROVIDER_URL=
# Conservative yt-dlp pacing. Production bounds are 5-10 seconds per download and 0-5 seconds per extractor request.
YTDLP_SLEEP_INTERVAL_SECONDS=5
YTDLP_MAX_SLEEP_INTERVAL_SECONDS=10
YTDLP_REQUEST_SLEEP_INTERVAL_SECONDS=1
YTDLP_PROXY_URL=
# Optional explicit WARP HTTP proxy. YTDLP_PROXY_URL takes precedence.
WARP_PROXY_URL=
# Optional standalone WARP sidecar host/port for paid or self-hosted deployments.
WARP_PROXY_HOST=
WARP_PROXY_PORT=8080
# Optional comma-separated WARP pool. Measured egress addresses are deduplicated before retries.
WARP_POOL_URLS=
# Embedded pool process count is capped to protect small worker instances.
WARP_POOL_SIZE=2
WARP_POOL_BASE_PORT=8080
WARP_POOL_MIN_HEALTHY=1
# Server-only HMAC key used to fingerprint egress addresses without storing raw IPs.
EGRESS_FINGERPRINT_KEY=
YTDLP_PROXY_PROBE_TIMEOUT_MS=15000
YTDLP_STARTUP_PROBE=true
# Set only on a controlled residential worker after a real yt-dlp probe succeeds.
TRUST_DIRECT_EGRESS=false
PYTHON_ACQUISITION_REQUIRED=false
PYTHON_ACQUISITION_URL=http://127.0.0.1:8090
PYTHON_ACQUISITION_PORT=8090
# Generated per container by start.sh when omitted. Never expose either value to the browser.
PYTHON_ACQUISITION_TOKEN=
VIDRIAL_ACQUISITION_WEBHOOK_SECRET=
# Optional self-hosted Cobalt instance. Hosted public Cobalt APIs must not be used without permission.
COBALT_API_URL=
COBALT_API_KEY=
COBALT_REQUEST_TIMEOUT_MS=45000
WORKER_TEMP_ROOT=/tmp/vidrial
WORKER_TEMP_DISK_LIMIT_BYTES=21474836480
CURL_PATH=curl
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_THREADS=1
CLAMAV_PATH=
VIRUS_SCAN_REQUIRED=false
LOG_LEVEL=info
