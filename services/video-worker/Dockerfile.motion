# Build from repository root: docker build -f services/video-worker/Dockerfile.motion .
# Never inject keys, tokens, worker env or .env files into this image.
FROM node:22-bookworm-slim AS build
WORKDIR /repo/services/video-worker
COPY services/video-worker/package*.json ./
RUN npm ci --no-audit --no-fund
COPY services/video-worker/tsconfig.json ./
COPY services/video-worker/src ./src
COPY services/video-worker/scripts ./scripts
COPY scripts/sync-motion-domain.mjs /repo/scripts/sync-motion-domain.mjs
COPY src/domain/motion /repo/src/domain/motion
RUN node /repo/scripts/sync-motion-domain.mjs && npm run build \
    && node scripts/bundle-motion-fonts.mjs /fonts \
    && npm prune --omit=dev --ignore-scripts

FROM node:22-bookworm-slim
ENV NODE_ENV=production HOME=/tmp TMPDIR=/tmp PLAYWRIGHT_BROWSERS_PATH=/opt/chromium
WORKDIR /renderer
COPY --from=build /repo/services/video-worker/package*.json ./
COPY --from=build /repo/services/video-worker/node_modules ./node_modules
# Copy only the credential-free runtime, excluding queue/controller/provider/storage code.
COPY --from=build /repo/services/video-worker/dist/motion/browser.js /repo/services/video-worker/dist/motion/audio.js /repo/services/video-worker/dist/motion/encode.js /repo/services/video-worker/dist/motion/frame-loop.js /repo/services/video-worker/dist/motion/limits.js /repo/services/video-worker/dist/motion/cli.js ./motion/
COPY --from=build /repo/services/video-worker/dist/motion/generated ./motion/generated
COPY --from=build /fonts/fonts.css ./fonts.css
COPY --from=build /fonts/*LICENSE.txt /usr/share/licenses/vidrial-motion/
RUN ./node_modules/.bin/playwright-core install --with-deps chromium \
    && apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-liberation tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 renderer && useradd --uid 10001 --gid 10001 --no-create-home renderer
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/renderer/motion/cli.js"]
