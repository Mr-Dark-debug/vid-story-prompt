{
  "name": "@vidrial/video-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "motion:start": "node dist/motion/controller.js",
    "motion:fonts": "node scripts/bundle-motion-fonts.mjs",
    "motion:demos": "tsx scripts/render-motion-demos.ts",
    "prebuild": "node ../../scripts/sync-motion-domain.mjs",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node ../../scripts/sync-motion-domain.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:motion": "vitest run src/motion"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.6",
    "@fontsource/manrope": "5.2.6",
    "@supabase/supabase-js": "^2.110.2",
    "archiver": "^8.0.0",
    "execa": "^9.6.1",
    "pino": "^9.7.0",
    "playwright-core": "1.61.1",
    "tus-js-client": "4.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.16.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
